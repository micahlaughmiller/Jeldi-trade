# Copy to .env in this folder and fill in. Never commit .env.
ACTIVE_TRADER=ASTRA

ASTRA_API_KEY=
ASTRA_API_SECRET=
CLAUDE_API_KEY=
CLAUDE_API_SECRET=
JAMES_API_KEY=
JAMES_API_SECRET=
SARAH_API_KEY=
SARAH_API_SECRET=
MARCUS_API_KEY=
MARCUS_API_SECRET=
ELENA_API_KEY=
ELENA_API_SECRET=
DAVID_API_KEY=
DAVID_API_SECRET=
ARIA_API_KEY=
ARIA_API_SECRET=
JORDAN_API_KEY=
JORDAN_API_SECRET=

PAPER_TRADING=true             # false -> https://api.alpaca.markets (real money)

# Optional: real-time ES futures via a Schwab account with futures data entitlement (see
# market_data.get_es_candles_live). Leave SCHWAB_APP_KEY/SECRET blank to keep using the delayed
# yfinance ES=F feed -- the bot falls back automatically, nothing else to configure. This is
# READ-ONLY market data borrowed from the same Schwab account/token the schwab/0dte folder already
# authenticates with; it never places any order from this folder.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# SCHWAB_TOKEN_PATH: leave unset to use config.py's hardcoded default (the Schwab folder's own
# token.json). Only set this if your Schwab folder lives somewhere else -- and even then, point it
# at that SAME file, never a separate copy: Schwab rotates the refresh token on each use, so two
# copies of the same token will invalidate each other.
SCHWAB_TOKEN_PATH=
