# Copy to .env in this folder and fill in. Never commit .env.
ACTIVE_TRADER=ASTRA

ASTRA_API_KEY=
ASTRA_API_SECRET=
ELENA_API_KEY=
ELENA_API_SECRET=
DAVID_API_KEY=
DAVID_API_SECRET=
ARIA_API_KEY=
ARIA_API_SECRET=
JORDAN_API_KEY=
JORDAN_API_SECRET=

PAPER_TRADING=true             # false -> https://api.alpaca.markets (real money)

# Optional: real-time ES futures via a Schwab account with futures data entitlement (see
# market_data.get_es_candles_live). Leave SCHWAB_APP_KEY/SECRET blank to keep using the delayed
# yfinance ES=F feed -- the bot falls back automatically, nothing else to configure. This is
# READ-ONLY market data; it never places any order from this folder.
# ASTRA (and only ASTRA) also keeps the Schwab access token fresh itself (schwab_keeper.py), so it needs BOTH values: the same
# app key and secret as schwab/0dte/.env. Do not run the Schwab sim bots alongside ASTRA. The 7-day Schwab login stays manual:
#   cd schwab/0dte && python schwab_login.py --force      (weekly, e.g. Sunday evening)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# SCHWAB_TOKEN_PATH: leave unset to use config.py's default (schwab/0dte/token.json next to this folder). Only set this if your
# Schwab folder lives somewhere else -- and point it at that SAME file, never a separate copy.
# SCHWAB_TOKEN_PATH=
