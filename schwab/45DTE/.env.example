# Copy to .env in this folder and fill in. Never commit .env or token.json.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8080
SCHWAB_ACCOUNT_INDEX=0         # which linked account (0 = first) -- check with schwab_login.py

# Schwab has NO paper trading. Leave false until you have watched several dry-run sessions.
SCHWAB_LIVE_ORDERS=false
