# Copy to .env in this folder and fill in. Never commit .env or token.json.
# This is the PAPER 45DTE bot (SCHWAB_MODE=sim): it reads Schwab quotes with LOGIN A and trades a simulated account. It has no token of its
# own: it reads ..\Micah\0dte\token.json (renew login A from schwab\Micah\0dte; never log in from here). Use the SAME SCHWAB_APP_KEY / SECRET
# as that folder. Paths in this file: write them WITHOUT quotes. The live-capable 45DTE bot is schwab\Micah\45DTE (same code).
SCHWAB_TOKEN_PATH=..\Micah\0dte\token.json
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8080
SCHWAB_ACCOUNT_INDEX=0         # which linked account the simulator READS (0 = first); nothing is traded in sim
SCHWAB_ACCOUNT_LAST4=          # optional: that account's last 4 digits (the bot then follows the digits and only warns about the index)

# Schwab has NO paper trading of its own. SCHWAB_MODE decides what happens to orders:
#   sim      trade a local simulated account filled against live Schwab quotes (THIS folder: keep sim)
#   dry_run  log the order payloads only; nothing is sent
#   live     send REAL orders (also requires SCHWAB_LIVE_ORDERS=true, else forced to dry_run) -- use schwab\Micah\45DTE for that
SCHWAB_MODE=sim
SIM_STARTING_EQUITY=30000      # simulated account size; reset it with `python sim_reset.py`
SCHWAB_LIVE_ORDERS=false

# Optional: fallback data source for index option chains Schwab does not serve
# (data only, no Alpaca orders). Not needed for the S&P 500 stock universe.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
