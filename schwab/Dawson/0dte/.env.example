# Copy to .env in this folder and fill in. Never commit .env or token.json.
# LAYOUT (2026-10-26): Dawson's 0DTE bot. It uses LOGIN A, the same Schwab login as Micah's bots. SCHWAB_APP_KEY / SECRET must be EXACTLY the
# values in ..\..\Micah\0dte\.env (one developer app per login): bots on the same app key share the newest login among them, so this folder
# finds Micah's token by itself and no token path is needed. A different app could not refresh login A, and a login made here with another
# app would break Micah's bots. Make this .env from THIS example (never by copying Micah's .env).
# Pick DAWSON'S account here:  python schwab_select_account.py   (it refuses the account Micah's folder already trades).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8080
SCHWAB_ACCOUNT_INDEX=0         # sim / dry_run only, when no account has been selected (live orders ignore it and need a selection, see GOING LIVE)

# Schwab has NO paper trading. SCHWAB_MODE decides what happens to orders:
#   sim      trade a local simulated account filled against live Schwab quotes (default)
#   dry_run  log the order payloads only; nothing is sent
#   live     send REAL orders (also requires SCHWAB_LIVE_ORDERS=true, else forced to dry_run)
SCHWAB_MODE=sim
SIM_STARTING_EQUITY=2000       # simulated account size; reset it with `python sim_reset.py`
SCHWAB_LIVE_ORDERS=false       # live mode only; leave false until you mean real money

# GOING LIVE (2026-10-15), after every token renewal:  python schwab_login.py --force   (it offers the account choice)  or  python schwab_select_account.py
# Live orders are refused until an account is selected. In dry_run/live the bot sees only the GREATER of LIVE_CAPITAL_FLOOR_USD or LIVE_CAPITAL_PCT of the
# account's total value (never more than the account holds; this bot process only) and opens at most LIVE_MAX_CONTRACTS_PER_TRADE contracts per order.
# The cap is a CEILING for this bot: profits and deposits never raise it, losses lower it, and anything else in the account (hand trades, withdrawals,
# the 45DTE bot) still moves the real balance. A bot that is already running keeps the account it started with: restart it after choosing another.
# LIVE_CAPITAL_FLOOR_USD=1000
# LIVE_CAPITAL_PCT=0.25
# LIVE_MAX_CONTRACTS_PER_TRADE=1
# One bot per account: if another person folder (schwab\<Person>\0dte) has selected the same account, this bot keeps managing what it holds but
# refuses NEW orders. Only if you really want two bots on one account:  SCHWAB_ALLOW_SHARED_ACCOUNT=true
# Paths in this file: write them WITHOUT quotes (quotes turn \t into a hidden TAB and the path silently breaks).

TRADER_NAME=DAWSON               # names this folder's saved day state, trade journal, log and single-instance lock

# Optional but needed for SPX: Schwab returns no option chain for $SPX on some accounts.
# With these set, SPXW quotes/expirations come from Alpaca's free indicative feed (data only,
# no Alpaca orders). Any Alpaca paper key pair works.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
