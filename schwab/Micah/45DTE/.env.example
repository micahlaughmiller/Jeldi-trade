# Copy to .env in this folder and fill in. Never commit .env or token.json.
# LAYOUT (2026-10-26): Micah's 45DTE bot, LOGIN A. It reads the login from ..\0dte\token.json; renew login A from ..\0dte. Use the SAME
# SCHWAB_APP_KEY / SECRET as ..\0dte\.env (one developer app per login). Keep this line, so a login made here lands in the shared file:
SCHWAB_TOKEN_PATH=..\0dte\token.json
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8080
# CAUTION: login A has TWO accounts (Micah's and Dawson's) and this bot has no account selector: it trades the account at SCHWAB_ACCOUNT_INDEX
# in Schwab's list, COUNTED FROM 0. To see the list without a new login:  cd ..\0dte  then  python schwab_select_account.py  -- read the
# table and press Enter (nothing is changed). Its # column counts from 1, so SCHWAB_ACCOUNT_INDEX = that number MINUS 1.
# Then put the account's last 4 digits in SCHWAB_ACCOUNT_LAST4: the bot trades the account with THOSE digits and only warns when the index
# disagrees (Schwab can reorder the list); no account or more than one with those digits is refused. Paths in this file: no quotes.
SCHWAB_ACCOUNT_INDEX=0
SCHWAB_ACCOUNT_LAST4=

# Schwab has NO paper trading. SCHWAB_MODE decides what happens to orders:
#   sim      trade a local simulated account filled against live Schwab quotes (default)
#   dry_run  log the order payloads only; nothing is sent
#   live     send REAL orders (also requires SCHWAB_LIVE_ORDERS=true, else forced to dry_run)
SCHWAB_MODE=sim
SIM_STARTING_EQUITY=30000      # simulated account size; reset it with `python sim_reset.py`
SCHWAB_LIVE_ORDERS=false       # live mode only; leave false until you mean real money

# Optional: fallback data source for index option chains Schwab does not serve
# (data only, no Alpaca orders). Not needed for the S&P 500 stock universe.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
