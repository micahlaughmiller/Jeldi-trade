# Copy to .env in this folder and fill in. Never commit .env or token.json.
# LAYOUT (2026-10-26): Ronnie's 45DTE bot, LOGIN B -- a DIFFERENT Schwab login from Micah's and Dawson's. Make this .env from THIS example
# (never by copying another folder's .env). It keeps its OWN token.json here (log in here:  python schwab_login.py --force) and never
# shares it. Use a SEPARATE Schwab developer app for login B (its own SCHWAB_APP_KEY / SECRET): a new login cancels an older login made
# with the same app for the same user, and whether one app can hold two users' logins at once has NOT been tested -- if it cannot,
# every Ronnie login would stop Micah's and Dawson's bots and every login-A renewal would stop Ronnie's.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8080
# This bot has no account selector: it trades the account at SCHWAB_ACCOUNT_INDEX in Schwab's list, COUNTED FROM 0 (python schwab_login.py
# prints 'index N: ...last4' for every account when it logs in). Put the account's last 4 digits in SCHWAB_ACCOUNT_LAST4: the bot trades
# the account with THOSE digits and only warns when the index disagrees. Paths in this file: write them WITHOUT quotes.
SCHWAB_ACCOUNT_INDEX=0
SCHWAB_ACCOUNT_LAST4=

# Schwab has NO paper trading. SCHWAB_MODE decides what happens to orders:
#   sim      trade a local simulated account filled against live Schwab quotes (default)
#   dry_run  log the order payloads only; nothing is sent
#   live     send REAL orders (also requires SCHWAB_LIVE_ORDERS=true, else forced to dry_run)
SCHWAB_MODE=sim
SIM_STARTING_EQUITY=30000      # simulated account size; reset it with `python sim_reset.py`
SCHWAB_LIVE_ORDERS=false       # live mode only; leave false until you mean real money

# Optional: fallback data source for index option chains Schwab does not serve
# (data only, no Alpaca orders). Not needed for the S&P 500 stock universe.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
